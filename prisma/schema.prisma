// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY    // Sedikit atau tidak ada olahraga
  LIGHT        // Olahraga ringan 1-3x/minggu
  MODERATE     // Olahraga sedang 3-5x/minggu
  ACTIVE       // Olahraga berat 6-7x/minggu
  VERY_ACTIVE  // Olahraga sangat berat + aktivitas fisik tinggi
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String?
  age            Int?
  heightCm       Float?
  weightKg       Float?
  gender         Gender?
  activityLevel  ActivityLevel?  @default(SEDENTARY)
  targetWeightKg Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  weightLogs      WeightLog[]
  foodEntries     FoodEntry[]
  exerciseEntries ExerciseEntry[]
  predictions     Prediction[]
}

model WeightLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg Float
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

/// Seed data — daftar makanan umum beserta info gizi per 100g
model FoodItem {
  id              String  @id @default(cuid())
  name            String  @unique
  caloriesPer100g Float   // kalori per 100g
  proteinPer100g  Float   @default(0)
  carbsPer100g    Float   @default(0)
  fatPer100g      Float   @default(0)
  servingSize     Float?  // ukuran porsi standar (gram)
  servingUnit     String? // label porsi, misal "1 piring", "1 buah"
  category        String? // kategori makanan

  foodEntries FoodEntry[]
}

/// Seed data — tabel MET (Metabolic Equivalent of Task)
/// Formula: kalori = MET × berat(kg) × durasi(jam)
model MetActivity {
  id       String  @id @default(cuid())
  name     String  @unique
  metValue Float   // nilai MET standar
  category String? // kategori aktivitas

  exerciseEntries ExerciseEntry[]
}

model FoodEntry {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItemId String
  foodItem   FoodItem  @relation(fields: [foodItemId], references: [id])
  amountGrams Float
  calories   Int
  mealType   MealType  @default(SNACK)
  loggedAt   DateTime  @default(now())

  @@index([userId, loggedAt])
}

model ExerciseEntry {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId      String
  activity        MetActivity @relation(fields: [activityId], references: [id])
  durationMinutes Int
  caloriesBurned  Int
  loggedAt        DateTime    @default(now())

  @@index([userId, loggedAt])
}

model Prediction {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avgDailyBalance  Float
  projectedWeeks   Int
  projectedDeltaKg Float
  aiInsight        String
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}
